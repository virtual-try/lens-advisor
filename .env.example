# ==============================================================================
# Lens Advisor - Environment Configuration Example
# Copy to .env and fill in required values for local development.
# ==============================================================================

# Server configuration
PORT=44010
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database (Postgres / Neon)
# DATABASE_URL: Pooled connection string (used by app and worker at runtime)
# DIRECT_URL: Direct unpooled connection string (used for migrations)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/lens_advisor?sslmode=require&connect_timeout=15
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/lens_advisor?sslmode=require

# ------------------------------------------------------------------------------
# Test Database (Local Postgres 16)
# Used by unit and integration tests needing a real Postgres instance.
# To start a local Postgres container with Docker:
#
#   docker run --name lens-advisor-pg \
#     -e POSTGRES_USER=postgres \
#     -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=lens_advisor_test \
#     -p 5432:5432 -d postgres:16-alpine
#
# ------------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lens_advisor_test

# ------------------------------------------------------------------------------
# Shopify App Credentials & URLs
# ------------------------------------------------------------------------------
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-domain.ngrok-free.app
SCOPES=read_products,write_products,read_orders,write_app_proxy,write_publications
# Optional: custom shop domain (e.g., custom admin domain)
SHOP_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# App Proxy
# Subpath configured in shopify.app.toml (defaults to lens-advisor)
# ------------------------------------------------------------------------------
APP_PROXY_SUBPATH=lens-advisor

# ------------------------------------------------------------------------------
# Billing (Shopify App Pricing)
# SHOPIFY_APP_HANDLE: the app's handle from the Partner Dashboard, used in the
# hosted plan-selection URL:
#   https://admin.shopify.com/store/<store>/charges/<app-handle>/pricing_plans
# Defaults to lens-advisor; override if the Partner Dashboard handle differs.
# PARTNER_ORGANIZATION_ID, PARTNER_API_ACCESS_TOKEN, SHOPIFY_APP_GID: credentials
# for querying active subscriptions via the Partner API activeSubscription query.
# ------------------------------------------------------------------------------
SHOPIFY_APP_HANDLE=lens-advisor
PARTNER_ORGANIZATION_ID=your_partner_organization_id
PARTNER_API_ACCESS_TOKEN=shppa_your_partner_api_access_token
SHOPIFY_APP_GID=gid://shopify/App/your_app_id

# ------------------------------------------------------------------------------
# Prescription Field Encryption (AES-256-GCM)
# RX_ENCRYPTION_KEYS: JSON object mapping keyId to a 32-byte base64-encoded key
# Example generation: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# ------------------------------------------------------------------------------
RX_ENCRYPTION_KEYS={"k1":"QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE="}
RX_ENCRYPTION_ACTIVE_KEY_ID=k1

# ------------------------------------------------------------------------------
# AWS S3 & KMS (Prescription file uploads & PDF lab tickets)
# ------------------------------------------------------------------------------
S3_BUCKET=lens-advisor-prescriptions-dev
S3_REGION=us-east-1
S3_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/sample-kms-key-id
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ------------------------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789_abcdef
MAIL_FROM=Lens Advisor <orders@mail.lensadvisor.io>
