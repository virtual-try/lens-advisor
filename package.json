{
  "name": "app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && react-router build && pnpm -r build",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "start:worker": "tsx app/worker.server.ts",
    "typecheck": "prisma generate && react-router typegen && tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "node -e 'console.log(\"owned by spec 33\"); process.exit(1)'",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "npm run setup && npm run start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@prisma/client": "6.19.2",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.15",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.3",
    "isbot": "^5.1.31",
    "pg-boss": "12.38.1",
    "prisma": "6.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "resend": "6.37.0",
    "vite-tsconfig-paths": "^6.0.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "^1.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "happy-dom": "^17.1.8",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^7.3.1",
    "vitest": "^3.0.7"
  }
}
